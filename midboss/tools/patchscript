#!/bin/bash
# ==============================================================================
# MidBoss Asset Preparation Script
# ==============================================================================

GAMEDIR="$(cd "$(dirname "$0")/.." && pwd)"
LOGFILE="$GAMEDIR/patchlog.txt"

exec > >(tee -a "$LOGFILE") 2>&1
echo "=== Starting MidBoss asset preparation ==="
echo "Working directory: $GAMEDIR"

# Ensure python extract script is executable
chmod +x "$GAMEDIR/tools/extract_midboss.py" 2>/dev/null || true

# Run python extraction script
python3 "$GAMEDIR/tools/extract_midboss.py"
RET=$?

if [ $RET -eq 0 ] && [ -f "$GAMEDIR/gamedata/MidBoss.exe" ]; then
    echo "MidBoss asset preparation succeeded!"
    touch "$GAMEDIR/install_completed"
    exit 0
else
    echo "ERROR: MidBoss asset preparation failed with code $RET!"
    exit 1
fi
